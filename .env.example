# Copy to .env for local Compose overrides. Never commit .env.
POSTGRES_PASSWORD=labpassword

# Host ports. Change these if 8080 or 5433 are already in use.
APP_PORT=8080
DB_PORT=5433

# Used when you run the app outside Docker (uvicorn app.main:app --reload).
DATABASE_URL=postgresql+psycopg://lab:labpassword@localhost:5433/labs
